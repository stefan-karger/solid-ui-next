{
  "name": "solid-ui-next",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:watch": "vitest",
    "validate": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@solidjs/web": "2.0.0-rc.1",
    "happy-dom": "20.10.6",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "solid-js": "2.0.0-rc.1",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "vite-plugin-solid": "3.0.0-next.27",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.13.1"
  },
  "packageManager": "pnpm@11.13.1"
}
