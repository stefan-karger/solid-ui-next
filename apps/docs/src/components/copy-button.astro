---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/lib/utils";

type Props = Omit<HTMLAttributes<"button">, "value"> & {
  value: string;
};

const { value, class: className, ...props } = Astro.props;
---

<button
  aria-label="Copy code"
  class={cn(
    "absolute top-3 right-2 z-10 flex size-7 items-center justify-center rounded-md bg-code text-code-foreground opacity-70 outline-none transition-[color,opacity,box-shadow] hover:bg-muted hover:opacity-100 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50",
    className,
  )}
  data-copy-button
  data-copy-value={value}
  data-slot="copy-button"
  type="button"
  {...props}
>
  <svg
    aria-hidden="true"
    class="size-4"
    data-copy-icon
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
  </svg>
  <svg
    aria-hidden="true"
    class="hidden size-4"
    data-check-icon
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M20 6 9 17l-5-5"></path>
  </svg>
  <span aria-live="polite" class="sr-only" data-copy-status>Copy code</span>
</button>

<script>
  function legacyCopy(value: string) {
    const textArea = document.createElement("textarea");
    textArea.value = value;
    textArea.readOnly = true;
    textArea.style.position = "fixed";
    textArea.style.opacity = "0";
    document.body.append(textArea);
    textArea.select();

    let copied = false;
    try {
      const execCommand = Reflect.get(document, "execCommand");
      copied =
        typeof execCommand === "function" && Reflect.apply(execCommand, document, ["copy"]);
    } finally {
      textArea.remove();
    }
    return copied;
  }

  async function copy(value: string) {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(value);
        return true;
      } catch {
        return legacyCopy(value);
      }
    }
    return legacyCopy(value);
  }

  function initializeCopyButton(button: HTMLButtonElement) {
    if (button.dataset.initialized === "true") return;
    button.dataset.initialized = "true";

    const copyIcon = button.querySelector<SVGElement>("[data-copy-icon]");
    const checkIcon = button.querySelector<SVGElement>("[data-check-icon]");
    const copyStatus = button.querySelector<HTMLElement>("[data-copy-status]");
    let resetTimer: number | undefined;

    button.addEventListener("click", async () => {
      const value = button.dataset.copyValue;
      if (!value || !(await copy(value))) return;

      button.dataset.copied = "true";
      button.setAttribute("aria-label", "Code copied");
      copyIcon?.classList.add("hidden");
      checkIcon?.classList.remove("hidden");
      if (copyStatus) copyStatus.textContent = "Code copied";

      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        delete button.dataset.copied;
        button.setAttribute("aria-label", "Copy code");
        copyIcon?.classList.remove("hidden");
        checkIcon?.classList.add("hidden");
        if (copyStatus) copyStatus.textContent = "Copy code";
      }, 2000);
    });
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-button]")) {
    initializeCopyButton(button);
  }
</script>
