---
import { randomUUID } from "node:crypto";

const PACKAGE_MANAGERS = ["pnpm", "npm", "yarn", "bun"] as const;
const DEFAULT_PACKAGE_MANAGER = "pnpm";

type PackageManager = (typeof PACKAGE_MANAGERS)[number];

type Props = Record<PackageManager, string>;

const commands = Astro.props;
const instanceId = `code-block-command-${randomUUID()}`;
---

<div
  class="relative min-w-0 overflow-hidden font-sans"
  data-code-block-command
  data-package-manager={DEFAULT_PACKAGE_MANAGER}
  data-slot="tabs"
>
  <div class="flex items-center gap-2 border-b border-border/50 px-3 py-1">
    <div
      aria-hidden="true"
      class="flex size-4 shrink-0 items-center justify-center rounded-[1px] bg-foreground opacity-70"
    >
      <svg
        class="size-3 text-code"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m4 17 6-6-6-6"></path>
        <path d="M12 19h8"></path>
      </svg>
    </div>

    <div aria-label="Package manager" class="flex items-center" role="tablist">
      {
        PACKAGE_MANAGERS.map((packageManager) => {
          const isActive = packageManager === DEFAULT_PACKAGE_MANAGER;
          const tabId = `${instanceId}-${packageManager}-tab`;
          const panelId = `${instanceId}-${packageManager}-panel`;

          return (
            <button
              aria-controls={panelId}
              aria-selected={isActive ? "true" : "false"}
              class="h-7 rounded-md border border-transparent px-2 pt-0.5 font-mono text-sm text-muted-foreground shadow-none outline-none transition-colors hover:text-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 data-[state=active]:border-input data-[state=active]:bg-background data-[state=active]:text-foreground"
              data-command-tab
              data-package-manager={packageManager}
              data-state={isActive ? "active" : "inactive"}
              id={tabId}
              role="tab"
              tabindex={isActive ? 0 : -1}
              type="button"
            >
              {packageManager}
            </button>
          );
        })
      }
    </div>
  </div>

  <div class="no-scrollbar overflow-x-auto">
    {
      PACKAGE_MANAGERS.map((packageManager) => {
        const isActive = packageManager === DEFAULT_PACKAGE_MANAGER;
        const tabId = `${instanceId}-${packageManager}-tab`;
        const panelId = `${instanceId}-${packageManager}-panel`;

        return (
          <div
            aria-labelledby={tabId}
            data-command-panel
            data-command={commands[packageManager]}
            data-package-manager={packageManager}
            data-state={isActive ? "active" : "inactive"}
            hidden={!isActive}
            id={panelId}
            role="tabpanel"
            tabindex="0"
          >
            <pre class="px-4 py-3.5"><code class="relative font-mono text-sm leading-none text-foreground" data-language="bash">{commands[packageManager]}</code></pre>
          </div>
        );
      })
    }
  </div>

  <button
    aria-label="Copy command"
    class="absolute top-2 right-2 z-10 flex size-7 items-center justify-center rounded-md text-code-foreground opacity-70 outline-none transition-[color,opacity,box-shadow] hover:bg-muted hover:opacity-100 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50"
    data-copy-command
    data-slot="copy-button"
    type="button"
  >
    <svg
      aria-hidden="true"
      class="size-4"
      data-copy-icon
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
    </svg>
    <svg
      aria-hidden="true"
      class="hidden size-4"
      data-check-icon
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
  </button>
  <span aria-live="polite" class="sr-only" data-copy-status></span>
</div>

<script>
  const STORAGE_KEY = "solid-ui-package-manager";
  const CHANGE_EVENT = "solid-ui:package-manager-change";
  const PACKAGE_MANAGERS = new Set(["pnpm", "npm", "yarn", "bun"]);

  function isPackageManager(value: string | undefined): value is string {
    return value !== undefined && PACKAGE_MANAGERS.has(value);
  }

  function setPackageManager(root: HTMLElement, packageManager: string, focus = false) {
    if (!isPackageManager(packageManager)) return;

    root.dataset.packageManager = packageManager;

    for (const tab of root.querySelectorAll<HTMLElement>("[data-command-tab]")) {
      const isActive = tab.dataset.packageManager === packageManager;
      tab.dataset.state = isActive ? "active" : "inactive";
      tab.setAttribute("aria-selected", String(isActive));
      tab.tabIndex = isActive ? 0 : -1;
      if (isActive && focus) tab.focus();
    }

    for (const panel of root.querySelectorAll<HTMLElement>("[data-command-panel]")) {
      const isActive = panel.dataset.packageManager === packageManager;
      panel.dataset.state = isActive ? "active" : "inactive";
      panel.hidden = !isActive;
    }
  }

  function persistPackageManager(packageManager: string) {
    try {
      localStorage.setItem(STORAGE_KEY, packageManager);
    } catch {
      // Storage may be disabled; the command block remains fully functional.
    }

    window.dispatchEvent(new CustomEvent(CHANGE_EVENT, { detail: packageManager }));
  }

  function getStoredPackageManager() {
    try {
      const storedValue = localStorage.getItem(STORAGE_KEY) ?? undefined;
      return isPackageManager(storedValue) ? storedValue : undefined;
    } catch {
      return undefined;
    }
  }

  function legacyCopy(value: string) {
    const textArea = document.createElement("textarea");
    textArea.value = value;
    textArea.readOnly = true;
    textArea.style.position = "fixed";
    textArea.style.opacity = "0";
    document.body.append(textArea);
    textArea.select();

    let copied = false;
    try {
      const execCommand = Reflect.get(document, "execCommand");
      copied =
        typeof execCommand === "function" && Reflect.apply(execCommand, document, ["copy"]);
    } finally {
      textArea.remove();
    }
    return copied;
  }

  async function copy(value: string) {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(value);
        return true;
      } catch {
        return legacyCopy(value);
      }
    }
    return legacyCopy(value);
  }

  function initializeCommandBlock(root: HTMLElement) {
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const tabs = [...root.querySelectorAll<HTMLElement>("[data-command-tab]")];
    const copyButton = root.querySelector<HTMLButtonElement>("[data-copy-command]");
    const copyIcon = root.querySelector<SVGElement>("[data-copy-icon]");
    const checkIcon = root.querySelector<SVGElement>("[data-check-icon]");
    const copyStatus = root.querySelector<HTMLElement>("[data-copy-status]");
    let copyResetTimer: number | undefined;

    setPackageManager(root, getStoredPackageManager() ?? "pnpm");

    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener("click", () => {
        const packageManager = tab.dataset.packageManager;
        if (!isPackageManager(packageManager)) return;
        setPackageManager(root, packageManager);
        persistPackageManager(packageManager);
      });

      tab.addEventListener("keydown", (event) => {
        let nextIndex: number | undefined;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;
        if (nextIndex === undefined) return;

        event.preventDefault();
        const packageManager = tabs[nextIndex]?.dataset.packageManager;
        if (!isPackageManager(packageManager)) return;
        setPackageManager(root, packageManager, true);
        persistPackageManager(packageManager);
      });
    }

    window.addEventListener(CHANGE_EVENT, (event) => {
      const packageManager = (event as CustomEvent<unknown>).detail;
      if (typeof packageManager === "string") setPackageManager(root, packageManager);
    });

    copyButton?.addEventListener("click", async () => {
      const activePanel = root.querySelector<HTMLElement>(
        `[data-command-panel][data-package-manager="${root.dataset.packageManager}"]`,
      );
      const command = activePanel?.dataset.command;
      if (!command || !(await copy(command))) return;

      copyButton.dataset.copied = "true";
      copyButton.setAttribute("aria-label", "Command copied");
      copyIcon?.classList.add("hidden");
      checkIcon?.classList.remove("hidden");
      if (copyStatus) copyStatus.textContent = "Command copied";

      window.clearTimeout(copyResetTimer);
      copyResetTimer = window.setTimeout(() => {
        delete copyButton.dataset.copied;
        copyButton.setAttribute("aria-label", "Copy command");
        copyIcon?.classList.remove("hidden");
        checkIcon?.classList.add("hidden");
        if (copyStatus) copyStatus.textContent = "";
      }, 2000);
    });
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-code-block-command]")) {
    initializeCommandBlock(root);
  }
</script>
