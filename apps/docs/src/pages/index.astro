---
import ClientIdleCounter from "@/components/ClientIdleCounter";
import ClientLoadCounter from "@/components/ClientLoadCounter";
import ClientMediaCounter from "@/components/ClientMediaCounter";
import ClientOnlyCounter from "@/components/ClientOnlyCounter";
import ClientVisibleCounter from "@/components/ClientVisibleCounter";
import ServerCounter from "@/components/ServerCounter";

// oxlint-disable-next-line import/no-unassigned-import
import "@/styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="An Astro 7 and Solid 2 beta server rendering and hydration playground."
    />
    <title>Astro 7 + Solid 2 Playground</title>
  </head>
  <body>
    <main class="mx-auto max-w-6xl px-5 py-14 sm:px-8 lg:py-24">
      <header class="mb-14 border-l-2 border-emerald-400 pl-6 lg:mb-20">
        <p class="mb-4 font-mono text-xs tracking-[0.25em] text-emerald-300 uppercase">
          Renderer compatibility lab / 2026
        </p>
        <h1 class="max-w-4xl text-4xl font-semibold tracking-[-0.04em] text-white sm:text-6xl">
          Astro 7 meets the <span class="text-emerald-300">Solid 2 beta</span> runtime.
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-7 text-slate-400 sm:text-lg">
          A static production build proving server rendering and every built-in Astro hydration
          strategy against a temporary Solid 2 renderer port.
        </p>
        <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 font-mono text-sm text-slate-300">
          <div><dt class="inline text-slate-500">Astro </dt><dd class="inline">7.1.0</dd></div>
          <div><dt class="inline text-slate-500">Solid </dt><dd class="inline">2.0.0-beta.19</dd></div>
          <div><dt class="inline text-slate-500">Vite </dt><dd class="inline">8.0.13</dd></div>
        </dl>
      </header>

      <div class="grid gap-5 md:grid-cols-2">
        <section data-testid="server-section"><ServerCounter /></section>
        <section data-testid="load-section"><ClientLoadCounter client:load /></section>
        <section data-testid="idle-section"><ClientIdleCounter client:idle /></section>
        <section data-testid="media-section">
          <ClientMediaCounter client:media="(min-width: 768px)" />
        </section>
        <section data-testid="only-section" class="md:col-span-2">
          <ClientOnlyCounter client:only="solid-js">
            <div
              slot="fallback"
              data-testid="only-counter-fallback"
              class="counter-card animate-pulse text-slate-400"
            >
              Loading client-only component...
            </div>
          </ClientOnlyCounter>
        </section>
      </div>

      <div aria-hidden="true" class="flex min-h-[150vh] items-center justify-center">
        <div class="h-px w-full bg-gradient-to-r from-transparent via-slate-700 to-transparent"></div>
      </div>

      <section data-testid="visible-section"><ClientVisibleCounter client:visible /></section>
      <footer class="mt-24 border-t border-slate-800 pt-8 font-mono text-xs text-slate-500">
        Static output. Chromium verified. No deployment adapter.
      </footer>
    </main>
  </body>
</html>

<style is:global>
  .counter-card {
    min-height: 16rem;
    border: 1px solid rgb(51 65 85 / 65%);
    border-radius: 0.75rem;
    padding: 1.5rem;
    background: linear-gradient(145deg, rgb(30 41 59 / 72%), rgb(15 23 42 / 40%));
    box-shadow: 0 20px 60px rgb(0 0 0 / 18%);
  }

  .counter-card h2 {
    margin-top: 0.4rem;
    color: white;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .counter-kicker {
    font-family: var(--font-mono);
    color: #6ee7b7;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .counter-copy {
    margin-top: 0.75rem;
    color: #94a3b8;
    line-height: 1.6;
  }

  .counter-control {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2rem;
  }

  .counter-control span {
    font-family: var(--font-mono);
    color: white;
    font-size: 2rem;
  }

  .counter-control button {
    border: 1px solid #34d399;
    border-radius: 999px;
    padding: 0.65rem 1rem;
    color: #a7f3d0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transition: 150ms ease;
  }

  .counter-control button:hover {
    color: #07110e;
    background: #6ee7b7;
  }
</style>
